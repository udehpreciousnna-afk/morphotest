# Copy this file to .env for local development (or set these in Render dashboard)

# App server port
PORT=3000

# Telegram
BOT_TOKEN=
BOT_USERNAME=MorphoMiningBot
APP_SHORT_NAME=myapp

# Database (leave empty locally to use PGlite)
DATABASE_URL=

# Dev browser fallback (ONLY local/dev)
ALLOW_DEV=false

# Public URL used for webhook callback generation (optional on Render; RENDER_EXTERNAL_URL is used automatically)
PUBLIC_URL=

# NOWPayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# Wallet/deposit economics
ETH_DEPOSIT_MIN=0.005
ETH_WITHDRAW_MIN=0.005
MORPHO_ETH_GATE=0.008
ETH_NETWORK_FEE=0.0005
ETH_DEPOSIT_CONFIRMATIONS=12
ETH_DEPOSIT_ETA_TEXT=typically 1–2 minutes

# Display-only indicative ETH/USD conversion for wallet UI
ETH_USD=2650

# Admin dashboard key
ADMIN_KEY=
