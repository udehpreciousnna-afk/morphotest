# ============================================================
# Mantle Mining App — Environment Variables
# Copy these into Render → your service → "Environment" tab.
# Replace every <PLACEHOLDER> with your real value.
# NEVER commit real values to git.
# ============================================================

# --- Database (PostgreSQL) ---
# On Render, create a PostgreSQL instance and paste its
# "Internal Database URL" here.
DATABASE_URL=<YOUR_POSTGRES_CONNECTION_URL>

# --- Auth secrets ---
# Generate one strong random string and use it for BOTH keys.
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=<YOUR_RANDOM_32_BYTE_SECRET>
AUTH_SECRET=<SAME_VALUE_AS_NEXTAUTH_SECRET>

# --- Public URL of your deployed app ---
# Set this to your Render URL once the service is created,
# e.g. https://mantle-mining.onrender.com
NEXTAUTH_URL=<YOUR_RENDER_APP_URL>

# --- Telegram Bot ---
# From @BotFather after you create your bot.
BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
BOT_USERNAME=<YOUR_BOT_USERNAME_WITHOUT_AT>

# Short name of the Mini App you registered in @BotFather
# (BotFather > /newapp > choose a short name).
APP_SHORT_NAME=<YOUR_MINI_APP_SHORT_NAME>

# --- Seed test account (optional) ---
# Used only by the one-time database seed script.
TEST_ACCOUNT_EMAIL=<ANY_EMAIL_FOR_SEED>
TEST_ACCOUNT_PASSWORD=<ANY_PASSWORD_FOR_SEED>

# --- Node ---
NODE_ENV=production
