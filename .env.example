# Copy this file to .env for local development (or set these in Render's dashboard)

# Port the server listens on (Render sets this automatically)
PORT=3000

# Your Telegram bot token from @BotFather (REQUIRED in production for secure login)
BOT_TOKEN=

# Your bot's username (without @)
BOT_USERNAME=MorphoMiningBot

# The Mini App short name you set in BotFather (the part after the bot in the link)
APP_SHORT_NAME=myapp

# PostgreSQL connection string.
# On Render this is provided automatically by the database.
# Leave EMPTY locally to use the built-in in-memory database (PGlite).
DATABASE_URL=

# Set to "true" ONLY for local browser testing so the app works without Telegram.
# NEVER set this in production.
ALLOW_DEV=false
